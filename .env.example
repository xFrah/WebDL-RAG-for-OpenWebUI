# Copy to .env (same directory) or export these in the environment.

# Base URL of your Open WebUI instance
OPENWEBUI_URL=http://localhost:3000

# API key: Open WebUI > Settings > Account > API Keys  (sk-...)
OPENWEBUI_API_KEY=

# Model used by query_knowledge_base (a model id shown in Open WebUI, e.g. "llama3.1:8b")
OPENWEBUI_DEFAULT_MODEL=

# Seconds to wait for embedding/RAG processing after upload (default 600)
KB_PROCESS_TIMEOUT=600

# Poll interval for the processing status endpoint (seconds)
KB_POLL_INTERVAL=2

# Max bytes to download before aborting (default 2 GiB)
KB_MAX_FILE_BYTES=2147483648